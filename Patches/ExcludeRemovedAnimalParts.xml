<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <!-- Exclude horns and tusks from removed animals from trader ExoticMisc stock generators -->
    
    <!-- Add vanilla animal parts to excludedThingDefs -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/TraderKindDef/stockGenerators/li[@Class='StockGenerator_Tag' and tradeTag='ExoticMisc']/excludedThingDefs</xpath>
        <value>
            <li>ThrumboHorn</li>
            <li>ElephantTusk</li>
        </value>
    </Operation>
    
    <!-- Odyssey animals that produce parts -->
    <Operation Class="PatchOperationAdd" MayRequire="Ludeon.RimWorld.Odyssey">
        <xpath>Defs/TraderKindDef/stockGenerators/li[@Class='StockGenerator_Tag' and tradeTag='ExoticMisc']/excludedThingDefs</xpath>
        <value>
            <li>MastodonTusk</li>
            <li>AlphaThrumboHorn</li>
        </value>
    </Operation>

    <!-- H&H Tools tags these as improvised weapons. Empty tags keep them out of pawn weapon generation. -->
    <Operation Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="ElephantTusk" or defName="ThrumboHorn"]/weaponTags</xpath>
        <match Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="ElephantTusk" or defName="ThrumboHorn"]/weaponTags</xpath>
            <value>
                <weaponTags Inherit="False" />
            </value>
        </match>
    </Operation>
    <Operation Class="PatchOperationConditional" MayRequire="Ludeon.RimWorld.Odyssey">
        <xpath>Defs/ThingDef[defName="MastodonTusk" or defName="AlphaThrumboHorn"]/weaponTags</xpath>
        <match Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="MastodonTusk" or defName="AlphaThrumboHorn"]/weaponTags</xpath>
            <value>
                <weaponTags Inherit="False" />
            </value>
        </match>
    </Operation>
    
</Patch>
